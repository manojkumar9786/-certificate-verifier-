# PostgreSQL connection string (Neon / Supabase / local).
# For quick local testing without Postgres you can use: sqlite:///./dev.db
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Any long random string
JWT_SECRET=change-me-to-a-long-random-string
# Frontend URL(s), comma separated (no trailing slash)
CLIENT_URL=http://localhost:5173
# Brevo (https://www.brevo.com) API key + a verified sender email.
# If BREVO_API_KEY is empty, the OTP is printed in the server console (dev only).
BREVO_API_KEY=
MAIL_FROM=you@example.com
MAIL_FROM_NAME=Certificate Verifier
# Admin login: this account is created (already verified, no OTP) on every startup.
# Log in with these on the normal login page.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
# Set to "production" on Render
ENV=development
